MONGODB_URI=mongodb+srv://user:password@example.mongodb.net
ADMIN_AUTH_DB_NAME=vantageadmin
ADMIN_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ADMIN_REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_TTL_DAYS=7
ADMIN_SEED_EMAIL=owner@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-password
NEXT_PUBLIC_APP_NAME=Vantage Admin

# Unit 2 proxy integration variables. Do not expose these to browser code.
VANTAGE_API_BASE_URL=https://vantage-movers-main-server.vercel.app
VANTAGE_API_SECRET=replace-with-main-server-secret

# Public, no-login employee booking form. Keep false to return 404 from both page and APIs.
EMPLOYEE_BOOKING_PUBLIC_ENABLED=true
# Optional override; defaults to VANTAGE_API_BASE_URL.
# EMPLOYEE_BOOKING_API_BASE_URL=https://vantage-movers-main-server.vercel.app
EMPLOYEE_BOOKING_PUBLIC_BODY_LIMIT_BYTES=16384
